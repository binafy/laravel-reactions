{
    "name": "binafy/laravel-reactions",
    "description": "Laravel Reactions is a simple and flexible package that allows you to add reaction functionality to any Eloquent model",
    "keywords": [
        "laravel reactions",
        "laravel-reactions",
        "binafy laravel-reactions",
        "binafy",
        "milwad",
        "milwad khosravi",
        "fun developer",
        "laravel reactions package",
        "laravel reactions github",
        "laravel",
        "laravel library",
        "reaction",
        "reactions",
        "like",
        "love",
        "clap",
        "eloquent",
        "laravel reaction eloquent"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/binafy/laravel-reactions",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Binafy\\LaravelReaction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Milwad Khosravi",
            "email": "milwad.dev@gmail.com",
            "role": "author",
            "homepage": "https://github.com/milwad-dev"
        },
        {
            "name": "Binafy",
            "role": "owner",
            "homepage": "https://github.com/binafy"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest-plugin-laravel": "^2.0.0|^3.1.0|^4.1.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore": [
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-8qx3-n5y5-vvnd",
                "PKSA-w7xr-vk7n-rstm"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html ./coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Binafy\\LaravelReaction\\Providers\\LaravelReactionServiceProvider"
            ]
        }
    }
}
