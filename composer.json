{
    "name": "binafy/laravel-reactions",
    "description": "Laravel Reactions is a simple and flexible package that allows you to add reaction functionality to any Eloquent model",
    "keywords": [
        "laravel reactions",
        "laravel-reactions",
        "binafy/laravel-reactions",
        "binafy",
        "milwad",
        "milwad khosravi",
        "fun developer",
        "laravel reactions package",
        "laravel reactions github",
        "laravel",
        "laravel library",
        "reaction",
        "reactions",
        "like",
        "love",
        "clap",
        "eloquent",
        "laravel reaction eloquent"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/binafy/laravel-reactions",
    "autoload": {
        "psr-4": {
            "Binafy\\LaravelReaction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Milwad",
            "email": "milwad.dev@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "require-dev": {
        "pestphp/pest-plugin-laravel": "^1.4.0|^2.0.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Binafy\\LaravelReaction\\Providers\\LaravelReactionServiceProvider"
            ]
        }
    }
}
